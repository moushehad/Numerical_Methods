'''
This program calculates derivatives and the corresponding
truncation error using the Three-Point Endpoint Formula

f'(x0) = [-3*f(x0) + 4*f(x0 + h) - f(x0 + 2h)]/(2h) -h^2f^(3)(k0)/3

We approximate the derivative for f(x) = x^(-2) for
x = 1.2, 1.5, 2.0, 3.0

We display the function. truncation error, and absolute error.

We graph the approx and exact solution in the same graph.
'''

import numpy as np
import matplotlib.pyplot as plt

# we first define out function and its derivatives

def f(x):
    return 1 / x**2

def f_prime(x):
    return -2 / x**3

def f_third(x):
    return -24 / x**5

# we next define the three-point endpoint formula

def three_point_endpoint(f, f_prime, f_third, x_values, h):

    # we define dummy variables for the approx and exact values
    approximations = []
    exact_values = []

    # we display a title
    print("THREE POINT ENDPOINT FORMULA")
    print("="*95)
    print(f"h = {h}")
    print()

    print(f"{'x':>8} {'Approximation':>18} {'Exact Value':>18}"
          f"{'Truncation Error':>20} {'Absolute Error':>20}")
    print("-"*95)

    # begin approximation
    for x0 in x_values:
          #-------------------------------------------------
          #Three-Point Endpoint Approximation
          #
          #f'(x0)   [-3f(x0) + 4f(x0 + h) - f(x0 + 2h)]/(2h)
          #-------------------------------------------------

          # Use formula 
          approximation = (
              -3 * f(x0)
              +4 * f(x0 + h)
              -f(x0 + 2*h)
              ) / (2*h)
          # Exact derivative
          exact = f_prime(x0)

          # Actual absolute error
          absolute_error = abs(exact - approximation)

          # Leading truncation-error estimate
          #
          # Error   -(h^2/3)f'''(x0)
          truncation_error = abs(
              -(h**2 / 3) * f_third(x0)
              )
          # fill dummy variables for approx and exact
          approximations.append(approximation)
          exact_values.append(exact)

          # display results
          print(
              f"{x0:8.2f} "
              f"{approximation:18.10f} "
              f"{exact:18.10f} "
              f"{truncation_error:20.10e} "
              f"{absolute_error:20.10e}"
              )

    #-------------------------------------------------
    # GRAPH
    #-------------------------------------------------

    # Smooth x-values for the exact derivative
    x_plot = np.linspace(
        min(x_values) - 0.1,
        max(x_values) + 0.1,
        500
        )

    # Exact derivative
    exact_plot = f_prime(x_plot)

    # Three_Point approximation over the same interval
    approx_plot = (
        -3 * f(x_plot)
        +4 * f(x_plot + h)
        -f(x_plot + 2*h)
        ) / (2*h)

    plt.figure(figsize = (9,6))

    # Exact derivative
    plt.plot(
        x_plot,
        exact_plot,
        linewidth=2,
        label="Exact derivative $f'(x)$"
        )
    # Three-point approximation
    plt.plot(
        x_plot,
        approx_plot,
        linestyle="--",
        linewidth = 2,
        label="Three-Point Endpoint Approximation"
        )
    # Approximation values at the requestied x-values
    plt.scatter(
        x_values,
        approximations,
        s=60,
        label="Computed approximations"
        )

    # plot details
    plt.xlabel("$x$")
    plt.ylabel("$f'(x)$")

    plt.title(
        "Exact Derivative vs. Three-Point Endpoint Approximation\n"
        r"$f(x)=\frac{1}{x^2}$, $h=0.1$"
        )

    plt.grid(True)
    plt.legend()
    plt.show()


#----------------------------------------
# CALL FUNCTION
#----------------------------------------

x_values = [1.2, 1.5, 2.0, 3.0]

h = 0.1

three_point_endpoint(f, f_prime, f_third, x_values, h)

